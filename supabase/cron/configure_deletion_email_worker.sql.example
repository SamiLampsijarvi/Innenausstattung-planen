-- Run only after RESEND_API_KEY and DELETION_EMAIL_FROM are configured.
-- Uses the same protected worker secret as the deletion worker.

select cron.schedule(
  'raumly-daily-deletion-email-worker',
  '30 3 * * *',
  $$
  select net.http_post(
    url := (select decrypted_secret from vault.decrypted_secrets where name = 'raumly_project_url') || '/functions/v1/send-deletion-notifications',
    headers := jsonb_build_object(
      'Content-Type', 'application/json',
      'x-raumly-worker-secret', (select decrypted_secret from vault.decrypted_secrets where name = 'raumly_deletion_worker_key_v2')
    ),
    body := '{}'::jsonb
  );
  $$
);
