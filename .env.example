# Die Bild-KI bleibt ohne diese serverseitigen Werte ausgeschaltet.
# Keine echten Zugangsdaten in diese Datei eintragen.
# Für den Planer erforderlich. Den tatsächlichen Projektwert lokal eintragen.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable-your-public-key
RAUMLY_IMAGE_AI_ENABLED=false
# Only exposes the authenticated internal test area, never enables Google.
RAUMLY_IMAGE_TEST_ENABLED=false
# Enables the anonymous preparation UI only. It cannot enable Vertex by itself.
NEXT_PUBLIC_RAUMLY_GUEST_IMAGE_TEST_ENABLED=false
# Displays the final start button. The server still requires RAUMLY_IMAGE_AI_ENABLED.
NEXT_PUBLIC_RAUMLY_GUEST_IMAGE_DISPATCH_ENABLED=false
# Local test only: permits the owner of a rejected candidate to inspect it for
# provider evaluation. Keep false for the normal product flow.
NEXT_PUBLIC_RAUMLY_INTERNAL_REJECTED_CANDIDATE_PREVIEW=false
# Server only: enables the anonymous test endpoint after its database migration.
RAUMLY_GUEST_IMAGE_TEST_ENABLED=false
# Server-side counterpart for the local rejected-candidate preview.
RAUMLY_INTERNAL_REJECTED_CANDIDATE_PREVIEW=false
# Exact browser origin, explicitly trusted by the server; no trailing slash.
RAUMLY_IMAGE_TEST_ORIGIN=http://localhost:3000
# Server only. Do not copy to NEXT_PUBLIC_* or commit a real value.
RAUMLY_PUBLIC_PILOT_MODE=false
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Billing-Export bleibt standardmäßig aus. Er liest ausschließlich den
# standardisierten Cloud-Billing-Export in BigQuery und startet niemals Vertex.
# Die Aktivierung des Exports, die BigQuery-Leserechte und ein Ausgabenlimit
# erfordern eine separate Betreiberfreigabe.
RAUMLY_BILLING_EXPORT_ENABLED=false
RAUMLY_BILLING_EXPORT_BIGQUERY_PROJECT=
RAUMLY_BILLING_EXPORT_TABLE=
RAUMLY_BILLING_EXPORT_LOCATION=
# Erst nach einem sichtbaren Exportposten eintragen; nicht raten.
RAUMLY_BILLING_EXPORT_SERVICE_DESCRIPTION=
RAUMLY_BILLING_EXPORT_IMPERSONATE_SERVICE_ACCOUNT=
# Optionaler vollständiger Pfad zur lokalen gcloud-CLI, wenn sie nicht im PATH liegt.
RAUMLY_GCLOUD_BIN=
RAUMLY_BILLING_EXPORT_MAX_BYTES_BILLED=

